{
  "name": "horizon-android",
  "version": "0.1.0",
  "private": true,
  "description": "F-Chat Horizon ported to Android via Capacitor. See README.md before building.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:web": "vite build",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npm run build && npm run cap:sync && npm run cap:open"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "any-ascii": "^0.3.3",
    "axios": "^0.30.0",
    "bluebird": "~3.7.2",
    "bootstrap": "^5.3.8",
    "date-fns": "2.30.0",
    "lodash": "^4.17.21",
    "qs": "^6.15.1",
    "sortablejs": "^1.15.7",
    "throat": "^5.0.0",
    "vue": "2.7.16",
    "vue-clickaway": "^2.2.2",
    "vue-input-tag": "^2.0.7",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/lodash": "4.14.162",
    "@types/node": "^20.0.0",
    "@types/qs": "^6.15.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue2": "^2.3.1",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "^1.8.27"
  }
}
